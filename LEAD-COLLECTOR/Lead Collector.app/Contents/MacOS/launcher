#!/bin/bash
# Avvia il server Lead Collector in background (nessun Terminale) e apre la pagina.
PORT=3000
URL="http://localhost:$PORT"

avviso() { osascript -e "display notification \"$1\" with title \"Lead Collector\"" >/dev/null 2>&1; }

# 1) Trova la cartella del progetto: accanto all'app, poi nei posti più comuni.
QUI="$(cd "$(dirname "$0")/../../.." 2>/dev/null && pwd)"
DIR=""
for c in "$QUI" "$HOME/Documents/progetti/code/LEAD-COLLECTOR" "$HOME/Documents/code/LEAD-COLLECTOR" "$HOME/code/LEAD-COLLECTOR"; do
  if [ -f "$c/server.js" ]; then DIR="$c"; break; fi
done
[ -z "$DIR" ] && { avviso "Cartella LEAD-COLLECTOR non trovata."; exit 1; }
cd "$DIR" || exit 1
mkdir -p data

# 1b) Se il server acceso è una versione vecchia (senza il ponte per LEADREWORKS, /api/ext/pending), lo ferma per riavviarlo nuovo.
CODICE="$(curl -s -o /dev/null -w '%{http_code}' "$URL/api/ext/pending" 2>/dev/null)"
if [ "$CODICE" != "000" ] && [ "$CODICE" != "200" ]; then
  VECCHIO="$(cat data/server.pid 2>/dev/null)"
  if [ -n "$VECCHIO" ] && ps -p "$VECCHIO" -o command= 2>/dev/null | grep -q 'server.js'; then
    kill "$VECCHIO" 2>/dev/null
    sleep 1
  fi
fi

# 2) Se il server non è già acceso, lo avvia in background.
if [ "$(curl -s -o /dev/null -w '%{http_code}' "$URL/" 2>/dev/null)" = "000" ]; then
  NODE="$(/bin/zsh -lic 'command -v node' 2>/dev/null | tail -1)"
  [ -x "$NODE" ] || NODE="$(command -v node || ls /opt/homebrew/bin/node /usr/local/bin/node 2>/dev/null | head -1)"
  [ -x "$NODE" ] || { avviso "Node.js non trovato."; exit 1; }
  nohup "$NODE" server.js >> data/server.log 2>&1 &
  echo $! > data/server.pid
  # attende che il server risponda (max ~15 secondi)
  for i in $(seq 1 30); do
    [ "$(curl -s -o /dev/null -w '%{http_code}' "$URL/" 2>/dev/null)" != "000" ] && break
    sleep 0.5
  done
fi

# 3) Apre la pagina come app indipendente (finestra senza schede, profilo Chrome separato).
CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
if [ "$(curl -s -o /dev/null -w '%{http_code}' "$URL/" 2>/dev/null)" = "000" ]; then
  avviso "Il server non parte. Vedi data/server.log"
  exit 1
fi
if [ -x "$CHROME" ]; then
  PASS="$(grep -E '^PAGE_PASSWORD=' .env 2>/dev/null | head -1 | cut -d= -f2- | tr -d "\"'\r")"
  AURL="$URL/"
  # la password, se semplice, entra una volta sola (il server la trasforma in cookie) e non va digitata
  if printf '%s' "$PASS" | grep -Eq '^[A-Za-z0-9._~-]+$'; then AURL="$URL/?pw=$PASS"; fi
  "$CHROME" --user-data-dir="$DIR/data/chrome-profile" --app="$AURL" \
    --no-first-run --no-default-browser-check --window-size=1280,860 >/dev/null 2>&1 &
else
  open "$URL/"
fi
