#!/bin/bash
# ============================================================================
# Eseguibile dell'app "Suggerimenti Vendita.app".
#
# Nessun terminale visibile: tutte le interazioni avvengono tramite finestre
# di dialogo (osascript). Fa esattamente quello che fa avvia_sistema.command,
# ma in versione "app" da tenere nel Dock e riaprire quando serve.
#
# Autosufficiente: contiene una copia propria di audio-capture/,
# matching-engine/, server/, schema/, overlay/ dentro Contents/Resources/
# progetto/. Puoi spostarla ovunque, anche da sola (es. nella cartella
# Applicazioni) — non serve tenerla accanto alle cartelle sorgenti.
# ============================================================================

# Radice del progetto = Contents/Resources/progetto DENTRO l'app stessa.
# L'app è autosufficiente: contiene una copia di audio-capture/,
# matching-engine/, server/, schema/, overlay/ — puoi spostare
# "Suggerimenti Vendita.app" ovunque (es. nella cartella Applicazioni) e
# continuerà a trovare tutto, senza bisogno delle cartelle sorgenti accanto.
# (Contents/MacOS/avvia -> Contents/Resources/progetto)
PROJECT_ROOT="$(cd "$(dirname "$0")/../Resources/progetto" && pwd)"
cd "$PROJECT_ROOT"

VENV_DIR="$PROJECT_ROOT/venv"
ENV_FILE="$PROJECT_ROOT/.env"
LOG_DIR="$PROJECT_ROOT/logs"
PY="$VENV_DIR/bin/python3"
PIP="$VENV_DIR/bin/pip"
mkdir -p "$LOG_DIR"

# Assicura che macOS conosca lo schema URL "suggerimentivendita://" (serve al
# pulsante "Invia a Suggerimenti Vendita" di Lead Rework Console per far
# comparire/portare in primo piano quest'app — vedi CFBundleURLTypes in
# Contents/Info.plist e application_openURLs_ in menu_finestra.py). macOS di
# norma registra da solo gli schemi URL degli app bundle al lancio, ma
# quando questa chiave dell'Info.plist è comparsa per la prima volta non lo
# ha fatto in automatico (visto dal vivo con l'utente: "open scheme://"
# rispondeva "No application knows how to open URL", risolto solo con
# lsregister -f a mano). Per non richiedere più quel passaggio manuale, lo
# rifacciamo ad ogni avvio: operazione innocua, quasi istantanea, in
# background per non rallentare l'apertura dell'app.
APP_BUNDLE="$(cd "$(dirname "$0")/../.." && pwd)"
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Versions/A/Frameworks/LaunchServices.framework/Versions/A/Support/lsregister"
if [ -x "$LSREGISTER" ]; then
  ("$LSREGISTER" -f "$APP_BUNDLE" >/dev/null 2>&1 &)
fi

TITOLO_APP="Suggerimenti Vendita"
LIBRERIA_SCRIPT="$PROJECT_ROOT/schema/esempio-libreria-script.json"
PYMOD_FRASI="$PROJECT_ROOT/matching-engine/gestione_frasi_raccolte.py"
PYMOD_GENERA="$PROJECT_ROOT/matching-engine/genera_testo_script.py"
PROFILO_AZIENDA="$PROJECT_ROOT/schema/profilo-azienda.json"

FASI_CHIAMATA=$'apertura\nscoperta\npresentazione\nobiezioni\nchiusura'
CATEGORIE_TRIGGER=$'obiezione_prezzo\nobiezione_tempo\nobiezione_concorrenza\nobiezione_autorita_decisionale\nobiezione_fiducia\nsegnale_interesse\nrichiesta_informazioni\nrichiesta_referenze\nsilenzio_o_esitazione\ntentativo_chiusura_cliente\nsaluto_apertura\naltro'

# ---------------------------------------------------------------------------
# Helper: dialoghi grafici
# ---------------------------------------------------------------------------

msg_info() {
  local escaped
  escaped=$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')
  osascript <<EOF > /dev/null 2>&1
display dialog "$escaped" with title "$TITOLO_APP" buttons {"OK"} default button "OK" with icon note
EOF
}

msg_errore() {
  local escaped
  escaped=$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')
  osascript <<EOF > /dev/null 2>&1
display dialog "$escaped" with title "$TITOLO_APP" buttons {"OK"} default button "OK" with icon stop
EOF
}

# Chiede una stringa di testo. Ritorna vuoto se l'utente annulla.
chiedi_testo() {
  osascript <<EOF 2>/dev/null
try
  set rispostaDialogo to display dialog "$1" with title "$TITOLO_APP" default answer "" buttons {"Annulla", "OK"} default button "OK"
  return text returned of rispostaDialogo
on error
  return ""
end try
EOF
}

# Come chiedi_testo, ma con un valore già pre-compilato (utile per modificare
# un valore già salvato in precedenza, es. il profilo azienda).
chiedi_testo_con_default() {
  local prompt="$1"
  local default_val="$2"
  local escaped_default
  escaped_default=$(printf '%s' "$default_val" | sed 's/\\/\\\\/g; s/"/\\"/g')
  osascript <<EOF 2>/dev/null
try
  set rispostaDialogo to display dialog "$prompt" with title "$TITOLO_APP" default answer "$escaped_default" buttons {"Annulla", "OK"} default button "OK"
  return text returned of rispostaDialogo
on error
  return ""
end try
EOF
}

# Converte righe (stdin) in una lista AppleScript {"a","b",...}
build_applescript_list() {
  local items=()
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    local escaped
    escaped=$(printf '%s' "$line" | sed 's/\\/\\\\/g; s/"/\\"/g')
    items+=("\"$escaped\"")
  done
  local joined
  joined=$(IFS=,; echo "${items[*]}")
  echo "{$joined}"
}

# Mostra una lista di scelta. Ritorna la voce scelta, o vuoto se annullato.
scegli_da_lista() {
  local elenco="$1"
  local prompt="$2"
  local as_list
  as_list=$(printf '%s\n' "$elenco" | build_applescript_list)
  osascript <<EOF 2>/dev/null
try
  set sceltaLista to choose from list $as_list with title "$TITOLO_APP" with prompt "$prompt"
  if sceltaLista is false then
    return ""
  else
    return item 1 of sceltaLista
  end if
on error
  return ""
end try
EOF
}

# Mostra un testo pre-compilato e MODIFICABILE, con 3 pulsanti: Rigenera,
# Annulla, Usa questo testo. Usato per rivedere le bozze generate dall'AI
# prima di salvarle. Ritorna il testo (eventualmente modificato dall'utente),
# oppure "###RIGENERA###" o "###ANNULLA###".
rivedi_testo_generato() {
  local prompt="$1"
  local testo="$2"
  local escaped
  escaped=$(printf '%s' "$testo" | sed 's/\\/\\\\/g; s/"/\\"/g')
  osascript <<EOF 2>/dev/null
try
  set rispostaDialogo to display dialog "$prompt" with title "$TITOLO_APP" default answer "$escaped" buttons {"Rigenera", "Annulla", "Usa questo testo"} default button "Usa questo testo" cancel button "Annulla"
  if button returned of rispostaDialogo is "Rigenera" then
    return "###RIGENERA###"
  else
    return text returned of rispostaDialogo
  end if
on error
  return "###ANNULLA###"
end try
EOF
}

# ---------------------------------------------------------------------------
# Helper: stato ambiente
# ---------------------------------------------------------------------------

carica_env() {
  [ -f "$ENV_FILE" ] || return 1
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
  [ -n "$DEEPGRAM_API_KEY" ] && [ -n "$ANTHROPIC_API_KEY" ]
}

richiedi_ambiente_pronto() {
  if [ ! -x "$PY" ]; then
    msg_errore "Devi prima usare \"Configura ambiente (prima volta)\" dal menu."
    return 1
  fi
  return 0
}

richiedi_api_key_pronte() {
  if ! carica_env; then
    msg_errore "Devi prima usare \"Configura API key\" dal menu."
    return 1
  fi
  return 0
}

# ---------------------------------------------------------------------------
# Passaggio: setup ambiente (venv + dipendenze)
# ---------------------------------------------------------------------------

# Un'app aperta con doppio click da Finder riceve un PATH molto più corto di
# quello di una sessione di Terminale (che carica anche .zprofile/.bash_profile):
# "command -v python3" da sola può non trovare un Python installato da
# python.org o Homebrew anche se nel Terminale funziona benissimo. Si cerca
# quindi direttamente nei percorsi di installazione noti, verificando che
# risponda davvero con una versione 3.x (non solo che il file esista).
trova_python3_sistema() {
  local log_debug="$LOG_DIR/python_debug.log"
  mkdir -p "$LOG_DIR"
  {
    echo "--- ricerca python3: $(date '+%Y-%m-%d %H:%M:%S') ---"
    echo "PATH corrente: $PATH"
  } >> "$log_debug" 2>&1

  local candidati=(
    "/usr/local/bin/python3"
    "/opt/homebrew/bin/python3"
    "/Library/Frameworks/Python.framework/Versions/3.13/bin/python3"
    "/Library/Frameworks/Python.framework/Versions/3.12/bin/python3"
    "/Library/Frameworks/Python.framework/Versions/3.11/bin/python3"
    "/Library/Frameworks/Python.framework/Versions/3.10/bin/python3"
    "/usr/bin/python3"
  )
  local candidato versione
  for candidato in "${candidati[@]}"; do
    if [ ! -x "$candidato" ]; then
      echo "candidato $candidato: non esiste o non eseguibile" >> "$log_debug"
      continue
    fi
    versione=$("$candidato" --version 2>&1)
    echo "candidato $candidato: --version -> [$versione]" >> "$log_debug"
    if echo "$versione" | grep -q "^Python 3\."; then
      echo "SCELTO: $candidato" >> "$log_debug"
      echo "$candidato"
      return 0
    fi
  done
  if command -v python3 &> /dev/null; then
    candidato=$(command -v python3)
    versione=$("$candidato" --version 2>&1)
    echo "fallback PATH ($candidato): --version -> [$versione]" >> "$log_debug"
    if echo "$versione" | grep -q "^Python 3\."; then
      echo "SCELTO (fallback PATH): $candidato" >> "$log_debug"
      echo "$candidato"
      return 0
    fi
  else
    echo "fallback PATH: command -v python3 non trova nulla" >> "$log_debug"
  fi
  echo "NESSUN PYTHON FUNZIONANTE TROVATO" >> "$log_debug"
  return 1
}

setup_ambiente() {
  local python3_sistema
  python3_sistema=$(trova_python3_sistema)
  if [ -z "$python3_sistema" ]; then
    msg_errore "Python non è installato correttamente su questo Mac (anche se il comando \"python3\" esiste, non funziona davvero — succede quando mancano gli Strumenti da riga di comando di Apple).

Soluzione più leggera (circa 30MB, non serve Xcode): vai su

python.org/downloads/macos

scarica l'ultima versione stabile (va bene 3.11, 3.12 o 3.13), apri il file .pkg e installa. Poi torna qui e riprova \"Configura ambiente\"."
    return
  fi

  msg_info "Inizio l'installazione. Premi OK e attendi qualche minuto (soprattutto la prima volta): l'app non mostrerà nulla mentre lavora, è normale."

  (
    set -e
    "$python3_sistema" -m venv "$VENV_DIR"
    "$PIP" install --upgrade pip
    "$PIP" install -r "$PROJECT_ROOT/audio-capture/requirements.txt"
    "$PIP" install -r "$PROJECT_ROOT/matching-engine/requirements.txt"
    "$PIP" install -r "$PROJECT_ROOT/server/requirements.txt"
    "$PIP" install -r "$PROJECT_ROOT/overlay/requirements.txt"
    "$PIP" install -r "$PROJECT_ROOT/menu/requirements.txt"
  ) > "$LOG_DIR/setup.log" 2>&1

  if [ $? -eq 0 ]; then
    msg_info "Setup completato con successo."
  else
    msg_errore "Si è verificato un problema durante il setup. Dettagli nel file logs/setup.log dentro la cartella del progetto."
  fi
}

# ---------------------------------------------------------------------------
# Passaggio: configurazione API key
# ---------------------------------------------------------------------------

configura_api_key() {
  local dg an
  dg=$(chiedi_testo "Deepgram API key (da deepgram.com):")
  [ -z "$dg" ] && { msg_errore "Operazione annullata."; return; }
  an=$(chiedi_testo "Anthropic API key (da console.anthropic.com):")
  [ -z "$an" ] && { msg_errore "Operazione annullata."; return; }

  cat > "$ENV_FILE" <<EOF
DEEPGRAM_API_KEY=$dg
ANTHROPIC_API_KEY=$an
EOF

  msg_info "API key salvate."
}

# ---------------------------------------------------------------------------
# Passaggio: configurare il profilo azienda (usato per generare i suggerimenti con l'AI)
# ---------------------------------------------------------------------------

configura_profilo_azienda() {
  local nome descrizione strategia regole

  local nome_attuale="" descrizione_attuale="" strategia_attuale="" regole_attuale=""
  if [ -f "$PROFILO_AZIENDA" ]; then
    nome_attuale=$("$PY" -c "import json; print(json.load(open('$PROFILO_AZIENDA')).get('nome_azienda',''))" 2>/dev/null)
    descrizione_attuale=$("$PY" -c "import json; print(json.load(open('$PROFILO_AZIENDA')).get('descrizione_prodotti',''))" 2>/dev/null)
    strategia_attuale=$("$PY" -c "import json; print(json.load(open('$PROFILO_AZIENDA')).get('strategia_commerciale',''))" 2>/dev/null)
    regole_attuale=$("$PY" -c "import json; print(json.load(open('$PROFILO_AZIENDA')).get('regole_fisse',''))" 2>/dev/null)
  fi

  msg_info "Queste informazioni verranno usate ogni volta che chiedi all'AI di proporre il testo di un suggerimento: più sono precise, più le proposte saranno utili. Te le chiedo una alla volta."

  nome=$(chiedi_testo_con_default "Nome dell'azienda:" "$nome_attuale")
  descrizione=$(chiedi_testo_con_default "Prodotti/servizi e contesto azienda (a chi vendete, cosa vi differenzia):" "$descrizione_attuale")
  strategia=$(chiedi_testo_con_default "Strategia commerciale da seguire (es. \"puntare sul valore, mai sul prezzo\", \"offrire sempre la demo prima dello sconto\"...):" "$strategia_attuale")
  regole=$(chiedi_testo_con_default "Regole fisse da rispettare sempre (tono, cose da non promettere mai, ecc.):" "$regole_attuale")

  NOME="$nome" DESCRIZIONE="$descrizione" STRATEGIA="$strategia" REGOLE="$regole" "$PY" - <<'PYEOF'
import json, os
profilo = {
    "nome_azienda": os.environ.get("NOME", ""),
    "descrizione_prodotti": os.environ.get("DESCRIZIONE", ""),
    "strategia_commerciale": os.environ.get("STRATEGIA", ""),
    "regole_fisse": os.environ.get("REGOLE", ""),
}
with open("schema/profilo-azienda.json", "w", encoding="utf-8") as f:
    json.dump(profilo, f, ensure_ascii=False, indent=2)
PYEOF

  msg_info "Profilo azienda salvato."
}

# ---------------------------------------------------------------------------
# Passaggio: aggiungere uno script alla libreria
# ---------------------------------------------------------------------------
#
# Uno "script" è: alcune frasi che il CLIENTE potrebbe dire (trigger_esempi,
# usate dall'AI per riconoscere la situazione) + il suggerimento che l'AI
# deve mostrare/evidenziare a monitor quando le riconosce.

aggiungi_script() {
  richiedi_ambiente_pronto || return

  local frase_iniziale="$1"
  local id_frase_da_segnare="$2"

  local fase categoria nome_breve id_script suggerimento alternativo priorita

  fase=$(scegli_da_lista "$FASI_CHIAMATA" "In quale fase della chiamata si usa questo script?")
  [ -z "$fase" ] && return

  categoria=$(scegli_da_lista "$CATEGORIE_TRIGGER" "Quale situazione lo attiva (categoria di innesco)?")
  [ -z "$categoria" ] && return

  nome_breve=$(chiedi_testo "Dai un nome breve a questo script, es. \"obiezione prezzo sconto\" (userà solo lettere minuscole, numeri e underscore):")
  [ -z "$nome_breve" ] && { msg_errore "Operazione annullata."; return; }
  id_script=$(printf '%s' "$nome_breve" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '_' | sed 's/^_*//; s/_*$//')
  if [ -z "$id_script" ]; then
    msg_errore "Nome non valido, riprova."
    return
  fi

  local esiste
  esiste=$(ID_DA_CERCARE="$id_script" "$PY" - <<'PYEOF'
import json, os
with open("schema/esempio-libreria-script.json", encoding="utf-8") as f:
    libreria = json.load(f)
print("si" if any(s["id"] == os.environ["ID_DA_CERCARE"] for s in libreria) else "no")
PYEOF
)
  if [ "$esiste" = "si" ]; then
    msg_errore "Esiste già uno script chiamato \"$id_script\". Scegli un nome diverso."
    return
  fi

  local file_frasi
  file_frasi=$(mktemp)

  if [ -n "$frase_iniziale" ]; then
    echo "$frase_iniziale" >> "$file_frasi"
    msg_info "Ho già inserito come primo esempio la frase raccolta dalla chiamata:

\"$frase_iniziale\"

Se vuoi, aggiungine altre (facoltativo, aiuta l'AI a generalizzare): te le chiedo una alla volta, lascia vuoto per continuare."
  else
    msg_info "Prima di tutto, scrivi alcune frasi che il CLIENTE potrebbe dire in questa situazione: sono quelle che l'AI userà per capire quando proporre questo script, e serviranno anche come contesto se vorrai far scrivere il suggerimento all'AI. Più ne dai (2-5), meglio riconosce la situazione anche se il cliente si esprime in modo diverso. Te le chiedo una alla volta: lascia vuoto quando hai finito."
  fi

  while true; do
    local frase
    frase=$(chiedi_testo "Frase di esempio del cliente (vuoto per terminare):")
    [ -z "$frase" ] && break
    echo "$frase" >> "$file_frasi"
  done

  if [ ! -s "$file_frasi" ]; then
    msg_errore "Serve almeno una frase di esempio: senza, l'AI non può riconoscere quando usare questo script. Operazione annullata."
    rm -f "$file_frasi"
    return
  fi

  # ---- testo del suggerimento: scritto a mano oppure generato dall'AI ----

  local modalita_suggerimento
  modalita_suggerimento=$(osascript <<EOF 2>/dev/null
try
  set rispostaDialogo to display dialog "Come vuoi scrivere il testo del suggerimento?" with title "$TITOLO_APP" buttons {"Annulla", "Lo scrivo io", "Genera con l'AI"} default button "Genera con l'AI" cancel button "Annulla"
  return button returned of rispostaDialogo
on error
  return "Annulla"
end try
EOF
)

  case "$modalita_suggerimento" in
    "Annulla")
      rm -f "$file_frasi"
      return
      ;;
    "Lo scrivo io")
      suggerimento=$(chiedi_testo "Cosa deve suggerire l'AI quando riconosce questa situazione? (il testo che verrà evidenziato a monitor)")
      ;;
    "Genera con l'AI")
      richiedi_api_key_pronte || { rm -f "$file_frasi"; return; }
      suggerimento=""
      while true; do
        local bozza
        bozza=$(FASE="$fase" CATEGORIA="$categoria" FILE_FRASI="$file_frasi" ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY" "$PY" "$PYMOD_GENERA" suggerimento 2>>"$LOG_DIR/generazione.log")
        if [ -z "$bozza" ]; then
          msg_errore "Non sono riuscito a generare una proposta (dettagli in logs/generazione.log). Scrivilo tu manualmente."
          suggerimento=$(chiedi_testo "Testo del suggerimento:")
          break
        fi
        local esito
        esito=$(rivedi_testo_generato "Ecco la proposta dell'AI (basata sul profilo azienda, se configurato). Puoi modificarla liberamente prima di usarla:" "$bozza")
        case "$esito" in
          "###RIGENERA###") continue ;;
          "###ANNULLA###") suggerimento=""; break ;;
          *) suggerimento="$esito"; break ;;
        esac
      done
      ;;
  esac

  if [ -z "$suggerimento" ]; then
    msg_errore "Operazione annullata: serve almeno il testo del suggerimento."
    rm -f "$file_frasi"
    return
  fi

  # ---- alternativa: facoltativa, scritta a mano o generata ----

  local modalita_alternativo
  modalita_alternativo=$(osascript <<EOF 2>/dev/null
try
  set rispostaDialogo to display dialog "Vuoi anche un suggerimento alternativo (mostrato in seconda posizione)?" with title "$TITOLO_APP" buttons {"Salta", "Lo scrivo io", "Genera con l'AI"} default button "Salta"
  return button returned of rispostaDialogo
on error
  return "Salta"
end try
EOF
)

  alternativo=""
  case "$modalita_alternativo" in
    "Lo scrivo io")
      alternativo=$(chiedi_testo "Suggerimento alternativo:")
      ;;
    "Genera con l'AI")
      if richiedi_api_key_pronte; then
        while true; do
          local bozza_alt
          bozza_alt=$(FASE="$fase" CATEGORIA="$categoria" FILE_FRASI="$file_frasi" SUGGERIMENTO_PRINCIPALE="$suggerimento" ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY" "$PY" "$PYMOD_GENERA" alternativa 2>>"$LOG_DIR/generazione.log")
          if [ -z "$bozza_alt" ]; then
            msg_errore "Non sono riuscito a generare un'alternativa. La salto."
            break
          fi
          local esito_alt
          esito_alt=$(rivedi_testo_generato "Ecco l'alternativa proposta dall'AI. Puoi modificarla liberamente:" "$bozza_alt")
          case "$esito_alt" in
            "###RIGENERA###") continue ;;
            "###ANNULLA###") alternativo=""; break ;;
            *) alternativo="$esito_alt"; break ;;
          esac
        done
      fi
      ;;
  esac

  priorita=$(chiedi_testo "Priorità da 1 a 10, usata solo per spareggi tra script ugualmente pertinenti (facoltativo, lascia vuoto per il valore standard 5):")
  case "$priorita" in
    ''|*[!0-9]*) priorita=5 ;;
  esac

  ID="$id_script" FASE="$fase" CATEGORIA="$categoria" SUGGERIMENTO="$suggerimento" \
  ALTERNATIVO="$alternativo" PRIORITA="$priorita" FILE_FRASI="$file_frasi" \
  "$PY" - <<'PYEOF'
import json, os

path = "schema/esempio-libreria-script.json"
with open(path, encoding="utf-8") as f:
    libreria = json.load(f)

with open(os.environ["FILE_FRASI"], encoding="utf-8") as f:
    trigger_esempi = [riga.strip() for riga in f if riga.strip()]

nuovo_script = {
    "id": os.environ["ID"],
    "fase_chiamata": os.environ["FASE"],
    "trigger_categoria": os.environ["CATEGORIA"],
    "trigger_esempi": trigger_esempi,
    "testo_suggerimento": os.environ["SUGGERIMENTO"],
    "condizioni_crm": {},
    "priorita": int(os.environ["PRIORITA"]),
    "tags": [],
    "attivo": True,
}
alternativo = os.environ.get("ALTERNATIVO", "").strip()
if alternativo:
    nuovo_script["testo_alternativo"] = alternativo

libreria.append(nuovo_script)

with open(path, "w", encoding="utf-8") as f:
    json.dump(libreria, f, ensure_ascii=False, indent=2)
PYEOF

  local numero_frasi
  numero_frasi=$(wc -l < "$file_frasi" | tr -d ' ')
  rm -f "$file_frasi"

  if [ -n "$id_frase_da_segnare" ]; then
    "$PY" "$PYMOD_FRASI" segna_creato_script "$id_frase_da_segnare" "$id_script" > /dev/null
  fi

  msg_info "Script \"$id_script\" aggiunto alla libreria ($numero_frasi frasi di esempio). Sarà attivo dalla prossima chiamata o test — non serve riavviare nient'altro.

Nota: per condizioni CRM avanzate (es. \"solo per lead enterprise\") va ancora modificato a mano il file schema/esempio-libreria-script.json — dimmelo se vuoi che aggiunga anche quello ai dialoghi."
}

# ---------------------------------------------------------------------------
# Passaggio: visualizzare gli script già presenti in libreria
# ---------------------------------------------------------------------------

visualizza_libreria() {
  richiedi_ambiente_pronto || return

  local elenco
  elenco=$("$PY" - <<'PYEOF'
