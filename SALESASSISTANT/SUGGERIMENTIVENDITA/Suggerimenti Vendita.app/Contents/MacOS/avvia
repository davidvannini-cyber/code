# ---------------------------------------------------------------------------
# Passaggio: rivedere le frasi raccolte durante le chiamate reali
# ---------------------------------------------------------------------------
#
# Questo è il meccanismo che fa "crescere" la libreria facendo le chiamate:
# ogni frase finale del cliente viene salvata (vedi server_suggerimenti.py)
# insieme a quale script era stato scelto, se non è stato scelto nulla. Qui
# le si rivede una alla volta e si decide cosa farne.

rivedi_frasi_raccolte() {
  richiedi_ambiente_pronto || return

  local totale
  totale=$("$PY" "$PYMOD_FRASI" conta_pendenti 2>/dev/null)
  if [ -z "$totale" ] || [ "$totale" -eq 0 ] 2>/dev/null; then
    msg_info "Non ci sono nuove frasi da rivedere. Compariranno qui dopo le prossime chiamate."
    return
  fi

  msg_info "Ci sono $totale frasi raccolte dalle chiamate da rivedere. Te le mostro una alla volta: per ognuna puoi aggiungerla a uno script esistente, usarla per crearne uno nuovo, oppure ignorarla. Puoi interrompere in qualsiasi momento: quelle non riviste restano per la prossima volta."

  local elenco
  elenco=$("$PY" "$PYMOD_FRASI" pendenti)

  while IFS=$'\t' read -r id fase script_scelto testo_breve; do
    [ -z "$id" ] && continue

    local descrizione_script
    if [ "$script_scelto" = "nessuno" ]; then
      descrizione_script="Durante la chiamata non era stato trovato nessuno script pertinente."
    else
      descrizione_script="Durante la chiamata era stato usato lo script \"$script_scelto\"."
    fi

    local fase_escaped testo_breve_escaped descrizione_script_escaped
    fase_escaped=$(printf '%s' "$fase" | sed 's/\\/\\\\/g; s/"/\\"/g')
    testo_breve_escaped=$(printf '%s' "$testo_breve" | sed 's/\\/\\\\/g; s/"/\\"/g')
    descrizione_script_escaped=$(printf '%s' "$descrizione_script" | sed 's/\\/\\\\/g; s/"/\\"/g')

    local risposta
    risposta=$(osascript <<EOF 2>/dev/null
try
  set rispostaDialogo to display dialog "Frase rilevata durante una chiamata (fase: $fase_escaped):

\"$testo_breve_escaped\"

$descrizione_script_escaped

Cosa vuoi farne?" with title "$TITOLO_APP" buttons {"Interrompi", "Ignora", "Usa questa frase"} default button "Usa questa frase" cancel button "Interrompi"
  return button returned of rispostaDialogo
on error
  return "Interrompi"
end try
EOF
)

    case "$risposta" in
      "Ignora")
        "$PY" "$PYMOD_FRASI" ignora "$id" > /dev/null
        ;;
      "Usa questa frase")
        local elenco_script scelta_script
        elenco_script=$("$PY" "$PYMOD_FRASI" elenco_script_brevi)
        elenco_script=$'➕ Crea un nuovo script con questa frase\n'"$elenco_script"
        scelta_script=$(scegli_da_lista "$elenco_script" "A quale script vuoi aggiungere questa frase, oppure creane uno nuovo:")

        if [ -z "$scelta_script" ]; then
          continue
        elif [ "$scelta_script" = "➕ Crea un nuovo script con questa frase" ]; then
          local testo_esatto
          testo_esatto=$("$PY" "$PYMOD_FRASI" testo_completo "$id")
          aggiungi_script "$testo_esatto" "$id"
        else
          local id_script_scelto esito
          id_script_scelto="${scelta_script%% | *}"
          esito=$("$PY" "$PYMOD_FRASI" aggiungi_a_script "$id" "$id_script_scelto")
          if [ "$esito" = "duplicato" ]; then
            msg_info "Questa frase era già tra gli esempi di \"$id_script_scelto\". Segnata come rivista."
          fi
        fi
        ;;
      *)
        break
        ;;
    esac
  done <<< "$elenco"

  msg_info "Revisione completata."
}

# ---------------------------------------------------------------------------
# Helper: selezione device audio
# ---------------------------------------------------------------------------

scegli_device_audio() {
  richiedi_ambiente_pronto || return 1

  local elenco
  elenco=$("$PY" - <<'PYEOF'
import sounddevice as sd
for i, d in enumerate(sd.query_devices()):
    if d['max_input_channels'] > 0:
        print(f"{i}: {d['name']}")
PYEOF
)

  if [ -z "$elenco" ]; then
    msg_errore "Nessun device audio di input trovato."
    return 1
  fi

  local scelta
  scelta=$(scegli_da_lista "$elenco" "Seleziona il device audio (il mic-in collegato allo splitter):")
  [ -z "$scelta" ] && return 1

  echo "${scelta%%:*}" | tr -d ' '
}

# ---------------------------------------------------------------------------
# Passaggio: test cattura audio isolato (15 secondi)
# ---------------------------------------------------------------------------

test_audio() {
  richiedi_ambiente_pronto || return
  richiedi_api_key_pronte || return

  local device
  device=$(scegli_device_audio)
  [ -z "$device" ] && return

  msg_info "Il test durerà 15 secondi: parla vicino al telefono. Premi OK per iniziare."

  (
    cd "$PROJECT_ROOT/audio-capture"
    # -u: output non bufferizzato, altrimenti le trascrizioni scritte nel log
    # possono andare perse quando il processo viene interrotto (il buffer di
    # Python non fa in tempo a scaricarsi su disco prima che il processo muoia).
    DEEPGRAM_API_KEY="$DEEPGRAM_API_KEY" "$PY" -u cattura_audio_stt.py --device "$device" > "$LOG_DIR/test_audio.log" 2>&1 &
    pid=$!
    sleep 15
    # SIGINT (non un kill secco): lo script lo intercetta e si chiude in
    # modo pulito, così anche l'ultima trascrizione fa in tempo a scriversi.
    kill -INT "$pid" 2>/dev/null
    sleep 0.5
  )

  open -a TextEdit "$LOG_DIR/test_audio.log"
  msg_info "Test terminato. Ho aperto le trascrizioni in TextEdit."
}

# ---------------------------------------------------------------------------
# Passaggio: test motore di matching (senza audio)
# ---------------------------------------------------------------------------

test_matching() {
  richiedi_ambiente_pronto || return
  richiedi_api_key_pronte || return

  msg_info "Carico il motore di matching, attendi qualche secondo — succede una sola volta per questo test, non ad ogni frase."

  # Un solo processo Python per l'intero test (non uno per frase): il
  # modello di embedding si carica UNA volta sola qui, poi resta caldo per
  # tutte le frasi che scrivi. È lo stesso motivo per cui la versione da
  # terminale (avvia_sistema.command) è sempre stata veloce dalla seconda
  # frase in poi — qui replichiamo lo stesso comportamento dentro l'app.
  TITOLO_APP="$TITOLO_APP" ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY" "$PY" - <<'PYEOF'
import os
import subprocess
import sys

sys.path.insert(0, "matching-engine")
from motore_suggerimenti import MotoreSuggerimenti

TITOLO = os.environ.get("TITOLO_APP", "Suggerimenti Vendita")


def escape(testo):
    return testo.replace("\\", "\\\\").replace('"', '\\"')


def chiedi_frase():
    script = (
        'try\n'
        f'  set rispostaDialogo to display dialog "Scrivi una frase come se fossi il cliente (lascia vuoto per tornare al menu):" '
        f'with title "{escape(TITOLO)}" default answer "" buttons {{"Annulla", "OK"}} default button "OK"\n'
        '  return text returned of rispostaDialogo\n'
        'on error\n'
        '  return ""\n'
        'end try\n'
    )
    risultato = subprocess.run(["osascript"], input=script, capture_output=True, text=True)
    return risultato.stdout.strip()


def msg_info(testo):
    script = (
        f'display dialog "{escape(testo)}" with title "{escape(TITOLO)}" '
        'buttons {"OK"} default button "OK" with icon note\n'
    )
    subprocess.run(["osascript"], input=script, capture_output=True, text=True)


motore = MotoreSuggerimenti("schema/esempio-libreria-script.json", "server/contesto-sessione-esempio.json")

while True:
    frase = chiedi_frase()
    if not frase:
        break
    r = motore.suggerisci(frase)
    if r:
        testo = f"[{r['fase_chiamata']}] {r['testo_suggerimento']}"
        if r.get("testo_alternativo"):
            testo += f"\n\nAlternativa: {r['testo_alternativo']}"
    else:
        testo = "Nessuno script pertinente trovato per questa frase."
    msg_info(testo)
PYEOF
}

# ---------------------------------------------------------------------------
# Passaggio: avvio sistema completo per una chiamata
# ---------------------------------------------------------------------------

# Avvia il server se non è già acceso (lo riusa se lo è: il motore di
# matching, con il modello di embedding, resta caricato in memoria tra una
# chiamata e l'altra — vedi server_suggerimenti.py, modalità --browser-audio
# — così solo la PRIMA chiamata di una sessione paga il caricamento del
# modello (15+ secondi), le successive partono quasi subito). Ritorna 0 solo
# quando il server risponde davvero su HTTP, altrimenti mostra l'errore e
# ritorna 1.
assicura_server_pronto() {
  local pid
  pid=$(cat "$LOG_DIR/server.pid" 2>/dev/null)

  if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
    # Microfono catturato dal BROWSER (getUserMedia), non da questa app:
    # così il permesso lo chiede Safari/Chrome (già firmati regolarmente da
    # Apple/Google), non la nostra app — che, senza un account sviluppatore
    # Apple a pagamento, non può ottenere il permesso microfono in modo
    # affidabile. La pagina va aperta via HTTP locale (non file://) perché i
    # browser concedano il microfono solo da un'origine "sicura".
    (
      cd "$PROJECT_ROOT/server"
      # -u: output non bufferizzato — altrimenti, siccome l'output va su file
      # e non su un terminale, Python lo tiene in memoria finché non si
      # riempie un blocco intero: un kill secco lo perderebbe tutto, log
      # incluso "Libreria caricata" e ogni trascrizione live.
      DEEPGRAM_API_KEY="$DEEPGRAM_API_KEY" ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY" \
        "$PY" -u server_suggerimenti.py --browser-audio > "$LOG_DIR/server.log" 2>&1 &
      echo $! > "$LOG_DIR/server.pid"
    )
    sleep 0.3
    pid=$(cat "$LOG_DIR/server.pid" 2>/dev/null)
  fi

  if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
    msg_errore "Il sistema non è partito correttamente. Dettagli nel file logs/server.log."
    return 1
  fi

  # Aspetta che il server risponda DAVVERO su HTTP prima di aprire il
  # browser, invece di un'attesa fissa indovinata: se sta ancora caricando
  # il modello, un'attesa fissa troppo corta apriva il browser su una pagina
  # non ancora pronta ("sito non trovato"), e siccome quella pagina non
  # arrivava mai a collegarsi non c'era modo di premere "Termina chiamata":
  # il server restava vivo per sempre e il menu bloccato con lui.
  local tentativi=0
  until curl -s -o /dev/null "http://localhost:8766/"; do
    if ! kill -0 "$pid" 2>/dev/null; then
      msg_errore "Il sistema non è partito correttamente. Dettagli nel file logs/server.log."
      return 1
    fi
    tentativi=$((tentativi + 1))
    if [ "$tentativi" -ge 150 ]; then
      msg_errore "Il sistema impiega troppo tempo ad avviarsi (oltre 30 secondi). Dettagli nel file logs/server.log."
      return 1
    fi
    sleep 0.2
  done
  return 0
}

# $1 (facoltativo): valore del parametro "avvio" passato all'overlay via URL
# (es. "rinforzo_facile_salire"), letto da server_suggerimenti.py per capire
# quale suggerimento iniziale mostrare subito invece di aspettare la prima
# frase del cliente. Vuoto = flusso standard, come sempre.
avvia_chiamata_comune() {
  local parametro_avvio="$1"

  richiedi_ambiente_pronto || return
  richiedi_api_key_pronte || return

  assicura_server_pronto || return

  local url="http://localhost:8766/"
  if [ -n "$parametro_avvio" ]; then
    url="${url}?avvio=${parametro_avvio}"
  fi

  # Ultima colonna (destra) sullo schermo principale, larghezza 40%: stesso
  # schema usato da apri-console.command (Lead Rework Console, 40%, a
  # sinistra di tutto) e menu_finestra.py (questo menu, 19%, nel mezzo) —
  # tre finestre affiancate in proporzioni fisse (scelte dall'utente).
  # Chrome in modalità app (--app=) invece di una tab normale: stesso
  # aspetto "chromeless" delle altre due, niente barra indirizzi/tab
  # visibili. "-na" forza una nuova istanza/finestra Chrome (altrimenti
  # "open -a" da solo ignora i parametri se Chrome è già aperto, stesso
  # motivo per cui apri-console.command usa lo stesso trucco).
  local bounds
  bounds=$(osascript -e 'tell application "Finder" to get bounds of window of desktop' 2>/dev/null)
  if [ -n "$bounds" ]; then
    local screen_w screen_h col_w col_x
    screen_w=$(echo "$bounds" | awk -F', ' '{print $3}')
    screen_h=$(echo "$bounds" | awk -F', ' '{print $4}')
    col_w=$(( screen_w * 40 / 100 ))
    col_x=$(( screen_w * 59 / 100 ))
    open -na "Google Chrome" --args --app="$url" --window-position=${col_x},0 --window-size=${col_w},${screen_h}
  else
    # Fallback se osascript non è disponibile per qualche motivo: comportamento precedente.
    open -na "Google Chrome" --args --app="$url"
  fi

  # Da qui in poi tutto avviene nella pagina: il microfono si attiva da
  # solo (se già autorizzato in passato) e c'è il pulsante "Termina
  # chiamata" per fermare — nessun dialogo o notifica di sistema, per non
  # duplicare quello che l'operatore vede già a schermo.
  #
  # Il server ora resta acceso tra una chiamata e l'altra (vedi
  # assicura_server_pronto), quindi non possiamo più aspettare che il
  # PROCESSO muoia per sapere quando la chiamata è finita: aspettiamo invece
  # il marker file che il server stesso crea/rimuove ad inizio/fine di ogni
  # chiamata (vedi _segna_chiamata in server_suggerimenti.py).
  local marker="$LOG_DIR/chiamata_attiva"
  local tentativi=0
  until [ -f "$marker" ]; do
    tentativi=$((tentativi + 1))
    if [ "$tentativi" -ge 150 ]; then
      # La pagina non si è mai collegata entro 30s (es. chiusa subito,
      # permesso mai concesso): non teniamo il menu bloccato per sempre.
      return
    fi
    sleep 0.2
  done
  while [ -f "$marker" ]; do
    sleep 0.2
  done
}

avvia_chiamata_yesmobility() {
  avvia_chiamata_comune ""
}

avvia_chiamata_gestione_lead() {
  avvia_chiamata_comune "gestione_lead"
}

avvia_chiamata_rinforzo() {
  avvia_chiamata_comune "rinforzo_facile_salire"
}

# ---------------------------------------------------------------------------
# Punto d'ingresso
# ---------------------------------------------------------------------------
#
# Con "--azione <nome>": esegue solo quella funzione ed esce. È così che il
# menu grafico (menu/menu_finestra.py) rilancia questo stesso eseguibile per
# ogni pulsante premuto — non è pensato per essere passato a mano.
#
# Senza argomenti: prova ad aprire il menu grafico; se non è disponibile
# (dipendenze PyObjC non installate: è così finché non hai fatto "Configura
# ambiente" almeno una volta), ripiega sul vecchio menu a lista testuale.

esegui_azione() {
  case "$1" in
    avvia_chiamata_yesmobility) avvia_chiamata_yesmobility ;;
    avvia_chiamata_gestione_lead) avvia_chiamata_gestione_lead ;;
    avvia_chiamata_rinforzo) avvia_chiamata_rinforzo ;;
    rivedi_frasi_raccolte) rivedi_frasi_raccolte ;;
    aggiungi_script) aggiungi_script ;;
    visualizza_libreria) visualizza_libreria ;;
    configura_profilo_azienda) configura_profilo_azienda ;;
    setup_ambiente) setup_ambiente ;;
    configura_api_key) configura_api_key ;;
    test_audio) test_audio ;;
    test_matching) test_matching ;;
    *) msg_errore "Azione sconosciuta: $1" ;;
  esac
}

if [ "$1" = "--azione" ] && [ -n "$2" ]; then
  esegui_azione "$2"
  exit 0
fi

# Prova ad aprire il menu grafico; ritorna 0 (e il chiamante può uscire) se
# ci è riuscito, 1 se non è disponibile (dipendenze mancanti) o non è
# partito correttamente — in quel caso si resta/ripiega sul menu testuale.
MENU_GRAFICO="$PROJECT_ROOT/menu/menu_finestra.py"
tenta_menu_grafico() {
  if [ -x "$PY" ] && [ -f "$MENU_GRAFICO" ]; then
    # "exec" (non una semplice chiamata) SOSTITUISCE questo processo bash con
    # python, mantenendo lo stesso PID — invece di restare un processo bash
    # che ha lanciato python come figlio. Perché conta: macOS/Launch Services
    # riconosce "l'app è già in esecuzione" (e instrada lì un successivo
    # "open suggerimentivendita://...", invece di aprirne una seconda copia)
    # guardando il processo lanciato come CFBundleExecutable di questo
    # bundle — cioè questo script bash. Senza "exec", quel processo resta
    # per sempre lo script bash (che non sa ricevere un evento URL: solo
    # l'NSApplication dentro Python lo sa fare), quindi Launch Services non
    # lo riconosce come "già in ascolto" e ne apre una seconda istanza da
    # zero — è il bug del secondo "Suggerimenti Vendita" che si apre anche
    # se il primo è già lì. Con "exec" invece è lo stesso processo (stesso
    # PID) a diventare l'NSApplication python, quindi Launch Services può
    # instradare lì gli eventi successivi.
    # Nota: da qui in poi non si torna più a questo script se l'exec
    # riesce — l'unico modo di arrivare alla riga sotto è se l'exec stesso
    # fallisce (es. python si interrompe nell'istante dell'avvio).
    exec "$PY" "$MENU_GRAFICO" "$0" "$PROJECT_ROOT" "$VENV_DIR" "$ENV_FILE" > "$LOG_DIR/menu.log" 2>&1
    echo "Menu grafico non partito correttamente, uso il menu testuale." >> "$LOG_DIR/menu.log"
  fi
  return 1
}

if tenta_menu_grafico; then
  exit 0
fi

# ---- ripiego: menu a lista testuale, se quello grafico non è disponibile ----

if [ ! -x "$PY" ]; then
  msg_info "Prima apertura: vedi questa lista invece dei pulsanti perché l'ambiente non è ancora configurato. Scegli \"Configura ambiente (prima volta)\" qui sotto — al termine il menu con i pulsanti si aprirà da solo, senza dover richiudere e riaprire l'app."
fi

OPZIONI=$'Chiamata YesMobility\nChiamata Gestione Lead\nRinforzo Facile Salire\nRivedi frasi raccolte dalle chiamate\nAggiungi uno script alla libreria\nVedi gli script già in libreria\nConfigura profilo azienda (per generazione AI)\nConfigura ambiente (prima volta)\nConfigura API key (prima volta)\nTest: solo audio (senza matching)\nTest: solo motore di matching\nEsci'

while true; do
  SCELTA=$(scegli_da_lista "$OPZIONI" "Cosa vuoi fare?")

  case "$SCELTA" in
    "Chiamata YesMobility") avvia_chiamata_yesmobility ;;
    "Chiamata Gestione Lead") avvia_chiamata_gestione_lead ;;
    "Rinforzo Facile Salire") avvia_chiamata_rinforzo ;;
    "Rivedi frasi raccolte dalle chiamate") rivedi_frasi_raccolte ;;
    "Aggiungi uno script alla libreria") aggiungi_script ;;
    "Vedi gli script già in libreria") visualizza_libreria ;;
    "Configura profilo azienda (per generazione AI)") configura_profilo_azienda ;;
    "Configura ambiente (prima volta)")
      setup_ambiente
      # Appena installato l'ambiente, il menu grafico potrebbe ora essere
      # disponibile: ci si passa subito, senza dover richiudere e riaprire
      # l'app per vederlo.
      if tenta_menu_grafico; then
        exit 0
      fi
      ;;
    "Configura API key (prima volta)") configura_api_key ;;
    "Test: solo audio (senza matching)") test_audio ;;
    "Test: solo motore di matching") test_matching ;;
    "Esci"|"") break ;;
  esac
done
