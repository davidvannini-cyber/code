#!/bin/bash
# Apre la Lead Rework Console come fa il pulsante dell'estensione Chrome (finestra senza schede,
# in alto a sinistra, 35% della larghezza e 90% dell'altezza dell'area di lavoro dello schermo
# principale), ma senza passare dati: i campi partono vuoti.
# Usa SEMPRE il profilo Chrome indicato qui sotto (PROFILO): i lead vivono nei dati di quel profilo e senza
# l'indicazione Chrome sceglie l'ultimo profilo usato, anche uno vuoto. Il nome è quello della CARTELLA del profilo
# (si legge in chrome://version -> "Percorso profilo"), non il nome mostrato da Chrome. Cambiarlo solo qui.
PROFILO="Profile 1"

avviso() { osascript -e "display notification \"$1\" with title \"Lead Rework\"" >/dev/null 2>&1; }

# 1) Trova la console: accanto all'app, poi nei posti più comuni.
QUI="$(cd "$(dirname "$0")/../../.." 2>/dev/null && pwd)"
FILE=""
for c in "$QUI" "$HOME/Documents/progetti/code/SALESASSISTANT/LEADREWORKS" "$HOME/Documents/code/SALESASSISTANT/LEADREWORKS" "$HOME/code/SALESASSISTANT/LEADREWORKS"; do
  if [ -f "$c/src/lead-rework-console.html" ]; then FILE="$c/src/lead-rework-console.html"; break; fi
done
[ -z "$FILE" ] && { avviso "lead-rework-console.html non trovato."; exit 1; }
# Uno spazio "crudo" in un indirizzo file:// manda in confusione Chrome: va convertito in %20.
# "#finestra=1": segnale per la console, che si ridimensiona e si posiziona da sola (non richiede permessi a macOS).
URL="file://${FILE// /%20}#finestra=1"

# 2) Area di lavoro dello schermo principale (esclude barra dei menu e Dock, come workArea dell'estensione).
GEO="$(osascript -l JavaScript -e 'ObjC.import("AppKit"); var s=$.NSScreen.screens.objectAtIndex(0); var f=s.frame, v=s.visibleFrame; [v.origin.x, f.size.height-(v.origin.y+v.size.height), v.size.width, v.size.height].map(Math.round).join(" ")' 2>/dev/null)"
set -- $GEO
if [ $# -eq 4 ]; then
  X=$1; Y=$2; W=$(( $3 * 35 / 100 )); H=$(( $4 * 90 / 100 ))
else
  # Alternativa: bordi dell'intera scrivania.
  BOUNDS="$(osascript -e 'tell application "Finder" to get bounds of window of desktop' 2>/dev/null)"
  SW=$(echo "$BOUNDS" | awk -F', ' '{print $3}'); SH=$(echo "$BOUNDS" | awk -F', ' '{print $4}')
  if [ -n "$SW" ] && [ -n "$SH" ]; then X=0; Y=25; W=$(( SW * 35 / 100 )); H=$(( SH * 88 / 100 )); else X=40; Y=40; W=900; H=700; fi
fi

# 3) -n: nuova istanza, altrimenti "open" riporta in primo piano Chrome e ignora gli argomenti.
open -na "Google Chrome" --args --profile-directory="$PROFILO" --app="$URL" --window-position=$X,$Y --window-size=$W,$H

# 4) Chrome si ricorda la dimensione dell'ultima finestra "app" e ignora quella richiesta all'avvio:
#    appena la finestra compare, posizione e dimensione si impongono direttamente (come fa l'estensione).
#    La prima volta macOS chiede di consentire il controllo di Chrome: va accettato.
#    Secondo metodo (oltre a quello della console stessa): AppleScript, che richiede il permesso
#    "Automazione" → Google Chrome; se manca, un avviso spiega dove concederlo.
R=$(( X + W )); B=$(( Y + H ))
for i in $(seq 1 20); do
  sleep 0.5
  OK=$(osascript -e "tell application \"Google Chrome\"
    set n to 0
    repeat with w in windows
      if (title of w) contains \"Lead Rework Console\" then
        set bounds of w to {$X, $Y, $R, $B}
        set n to n + 1
      end if
    end repeat
    return n
  end tell" 2>/tmp/lead-rework-launcher.err)
  [ "${OK:-0}" -gt 0 ] 2>/dev/null && break
done
if ! [ "${OK:-0}" -gt 0 ] 2>/dev/null && grep -q "1743\|non è autorizzat\|not authorized" /tmp/lead-rework-launcher.err 2>/dev/null; then
  avviso "Per la posizione della finestra: Impostazioni di Sistema > Privacy e sicurezza > Automazione > consenti Lead Rework a controllare Google Chrome."
fi
