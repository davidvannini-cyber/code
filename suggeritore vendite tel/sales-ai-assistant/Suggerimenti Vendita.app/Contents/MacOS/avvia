# ---------------------------------------------------------------------------
# Passaggio: rivedere le frasi raccolte durante le chiamate reali
# ---------------------------------------------------------------------------
#
# Questo è il meccanismo che fa "crescere" la libreria facendo le chiamate:
# ogni frase finale del cliente viene salvata (vedi server_suggerimenti.py)
# insieme a quale script era stato scelto, se non è stato scelto nulla. Qui
# le si rivede una alla volta e si decide cosa farne.

rivedi_frasi_raccolte() {
  richiedi_ambiente_pronto || return

  local totale
  totale=$("$PY" "$PYMOD_FRASI" conta_pendenti 2>/dev/null)
  if [ -z "$totale" ] || [ "$totale" -eq 0 ] 2>/dev/null; then
    msg_info "Non ci sono nuove frasi da rivedere. Compariranno qui dopo le prossime chiamate."
    return
  fi

  msg_info "Ci sono $totale frasi raccolte dalle chiamate da rivedere. Te le mostro una alla volta: per ognuna puoi aggiungerla a uno script esistente, usarla per crearne uno nuovo, oppure ignorarla. Puoi interrompere in qualsiasi momento: quelle non riviste restano per la prossima volta."

  local elenco
  elenco=$("$PY" "$PYMOD_FRASI" pendenti)

  while IFS=$'\t' read -r id fase script_scelto testo_breve; do
    [ -z "$id" ] && continue

    local descrizione_script
    if [ "$script_scelto" = "nessuno" ]; then
      descrizione_script="Durante la chiamata non era stato trovato nessuno script pertinente."
    else
      descrizione_script="Durante la chiamata era stato usato lo script \"$script_scelto\"."
    fi

    local fase_escaped testo_breve_escaped descrizione_script_escaped
    fase_escaped=$(printf '%s' "$fase" | sed 's/\\/\\\\/g; s/"/\\"/g')
    testo_breve_escaped=$(printf '%s' "$testo_breve" | sed 's/\\/\\\\/g; s/"/\\"/g')
    descrizione_script_escaped=$(printf '%s' "$descrizione_script" | sed 's/\\/\\\\/g; s/"/\\"/g')

    local risposta
    risposta=$(osascript <<EOF 2>/dev/null
try
  set rispostaDialogo to display dialog "Frase rilevata durante una chiamata (fase: $fase_escaped):

\"$testo_breve_escaped\"

$descrizione_script_escaped

Cosa vuoi farne?" with title "$TITOLO_APP" buttons {"Interrompi", "Ignora", "Usa questa frase"} default button "Usa questa frase" cancel button "Interrompi"
  return button returned of rispostaDialogo
on error
  return "Interrompi"
end try
EOF
)

    case "$risposta" in
      "Ignora")
        "$PY" "$PYMOD_FRASI" ignora "$id" > /dev/null
        ;;
      "Usa questa frase")
        local elenco_script scelta_script
        elenco_script=$("$PY" "$PYMOD_FRASI" elenco_script_brevi)
        elenco_script=$'➕ Crea un nuovo script con questa frase\n'"$elenco_script"
        scelta_script=$(scegli_da_lista "$elenco_script" "A quale script vuoi aggiungere questa frase, oppure creane uno nuovo:")

        if [ -z "$scelta_script" ]; then
          continue
        elif [ "$scelta_script" = "➕ Crea un nuovo script con questa frase" ]; then
          local testo_esatto
          testo_esatto=$("$PY" "$PYMOD_FRASI" testo_completo "$id")
          aggiungi_script "$testo_esatto" "$id"
        else
          local id_script_scelto esito
          id_script_scelto="${scelta_script%% | *}"
          esito=$("$PY" "$PYMOD_FRASI" aggiungi_a_script "$id" "$id_script_scelto")
          if [ "$esito" = "duplicato" ]; then
            msg_info "Questa frase era già tra gli esempi di \"$id_script_scelto\". Segnata come rivista."
          fi
        fi
        ;;
      *)
        break
        ;;
    esac
  done <<< "$elenco"

  msg_info "Revisione completata."
}

# ---------------------------------------------------------------------------
# Helper: selezione device audio
# ---------------------------------------------------------------------------

scegli_device_audio() {
  richiedi_ambiente_pronto || return 1

  local elenco
  elenco=$("$PY" - <<'PYEOF'
import sounddevice as sd
for i, d in enumerate(sd.query_devices()):
    if d['max_input_channels'] > 0:
        print(f"{i}: {d['name']}")
PYEOF
)

  if [ -z "$elenco" ]; then
    msg_errore "Nessun device audio di input trovato."
    return 1
  fi

  local scelta
  scelta=$(scegli_da_lista "$elenco" "Seleziona il device audio (il mic-in collegato allo splitter):")
  [ -z "$scelta" ] && return 1

  echo "${scelta%%:*}" | tr -d ' '
}

# ---------------------------------------------------------------------------
# Passaggio: test cattura audio isolato (15 secondi)
# ---------------------------------------------------------------------------

test_audio() {
  richiedi_ambiente_pronto || return
  richiedi_api_key_pronte || return

  local device
  device=$(scegli_device_audio)
  [ -z "$device" ] && return

  msg_info "Il test durerà 15 secondi: parla vicino al telefono. Premi OK per iniziare."

  (
    cd "$PROJECT_ROOT/audio-capture"
    DEEPGRAM_API_KEY="$DEEPGRAM_API_KEY" "$PY" cattura_audio_stt.py --device "$device" > "$LOG_DIR/test_audio.log" 2>&1 &
    pid=$!
    sleep 15
    kill "$pid" 2>/dev/null
  )

  open -a TextEdit "$LOG_DIR/test_audio.log"
  msg_info "Test terminato. Ho aperto le trascrizioni in TextEdit."
}

# ---------------------------------------------------------------------------
# Passaggio: test motore di matching (senza audio)
# ---------------------------------------------------------------------------

test_matching() {
  richiedi_ambiente_pronto || return
  richiedi_api_key_pronte || return

  while true; do
    local frase
    frase=$(chiedi_testo "Scrivi una frase come se fossi il cliente (lascia vuoto per tornare al menu). Il calcolo richiede qualche secondo:")
    [ -z "$frase" ] && break

    local risultato
    risultato=$(ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY" "$PY" - "$frase" <<'PYEOF'
import sys
sys.path.insert(0, "matching-engine")
from motore_suggerimenti import MotoreSuggerimenti

motore = MotoreSuggerimenti("schema/esempio-libreria-script.json", "server/contesto-sessione-esempio.json")
frase = sys.argv[1]
r = motore.suggerisci(frase)
if r:
    testo = f"[{r['fase_chiamata']}] {r['testo_suggerimento']}"
    if r.get("testo_alternativo"):
        testo += f"\n\nAlternativa: {r['testo_alternativo']}"
    print(testo)
else:
    print("Nessuno script pertinente trovato per questa frase.")
PYEOF
)
    msg_info "$risultato"
  done
}

# ---------------------------------------------------------------------------
# Passaggio: avvio sistema completo per una chiamata
# ---------------------------------------------------------------------------

avvia_chiamata() {
  richiedi_ambiente_pronto || return
  richiedi_api_key_pronte || return

  local device
  device=$(scegli_device_audio)
  [ -z "$device" ] && return

  # Overlay in una finestra flottante, sempre in primo piano (vedi
  # overlay/overlay_finestra.py). Se le dipendenze PyObjC non sono
  # installate (es. non hai rifatto "Configura ambiente" dopo un
  # aggiornamento), ripiega su una normale scheda del browser.
  local pid_overlay msg_overlay
  "$PY" "$PROJECT_ROOT/overlay/overlay_finestra.py" > "$LOG_DIR/overlay.log" 2>&1 &
  pid_overlay=$!
  sleep 1.5
  if kill -0 "$pid_overlay" 2>/dev/null; then
    echo "$pid_overlay" > "$LOG_DIR/overlay.pid"
    msg_overlay="overlay in una finestra sempre in primo piano"
  else
    pid_overlay=""
    rm -f "$LOG_DIR/overlay.pid"
    open "$PROJECT_ROOT/overlay/index.html"
    msg_overlay="overlay aperto nel browser (finestra sempre in primo piano non disponibile: dettagli in logs/overlay.log)"
  fi

  (
    cd "$PROJECT_ROOT/server"
    DEEPGRAM_API_KEY="$DEEPGRAM_API_KEY" ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY" \
      "$PY" server_suggerimenti.py --device "$device" > "$LOG_DIR/server.log" 2>&1 &
    echo $! > "$LOG_DIR/server.pid"
  )

  sleep 2
  local pid
  pid=$(cat "$LOG_DIR/server.pid" 2>/dev/null)

  if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
    msg_errore "Il sistema non è partito correttamente. Dettagli nel file logs/server.log."
    [ -n "$pid_overlay" ] && kill "$pid_overlay" 2>/dev/null
    rm -f "$LOG_DIR/overlay.pid"
    return
  fi

  msg_info "Sistema avviato, $msg_overlay. Premi OK QUANDO VUOI FERMARE la chiamata."

  kill "$pid" 2>/dev/null
  [ -n "$pid_overlay" ] && kill "$pid_overlay" 2>/dev/null
  rm -f "$LOG_DIR/server.pid" "$LOG_DIR/overlay.pid"
  msg_info "Sistema fermato."
}

# ---------------------------------------------------------------------------
# Punto d'ingresso
# ---------------------------------------------------------------------------
#
# Con "--azione <nome>": esegue solo quella funzione ed esce. È così che il
# menu grafico (menu/menu_finestra.py) rilancia questo stesso eseguibile per
# ogni pulsante premuto — non è pensato per essere passato a mano.
#
# Senza argomenti: prova ad aprire il menu grafico; se non è disponibile
# (dipendenze PyObjC non installate: è così finché non hai fatto "Configura
# ambiente" almeno una volta), ripiega sul vecchio menu a lista testuale.

esegui_azione() {
  case "$1" in
    avvia_chiamata) avvia_chiamata ;;
    rivedi_frasi_raccolte) rivedi_frasi_raccolte ;;
    aggiungi_script) aggiungi_script ;;
    visualizza_libreria) visualizza_libreria ;;
    configura_profilo_azienda) configura_profilo_azienda ;;
    setup_ambiente) setup_ambiente ;;
    configura_api_key) configura_api_key ;;
    test_audio) test_audio ;;
    test_matching) test_matching ;;
    *) msg_errore "Azione sconosciuta: $1" ;;
  esac
}

if [ "$1" = "--azione" ] && [ -n "$2" ]; then
  esegui_azione "$2"
  exit 0
fi

# Prova ad aprire il menu grafico; ritorna 0 (e il chiamante può uscire) se
# ci è riuscito, 1 se non è disponibile (dipendenze mancanti) o non è
# partito correttamente — in quel caso si resta/ripiega sul menu testuale.
MENU_GRAFICO="$PROJECT_ROOT/menu/menu_finestra.py"
tenta_menu_grafico() {
  if [ -x "$PY" ] && [ -f "$MENU_GRAFICO" ]; then
    "$PY" "$MENU_GRAFICO" "$0" "$PROJECT_ROOT" "$VENV_DIR" "$ENV_FILE" > "$LOG_DIR/menu.log" 2>&1
    if [ $? -eq 0 ]; then
      return 0
    fi
    echo "Menu grafico non partito correttamente, uso il menu testuale." >> "$LOG_DIR/menu.log"
  fi
  return 1
}

if tenta_menu_grafico; then
  exit 0
fi

# ---- ripiego: menu a lista testuale, se quello grafico non è disponibile ----

if [ ! -x "$PY" ]; then
  msg_info "Prima apertura: vedi questa lista invece dei pulsanti perché l'ambiente non è ancora configurato. Scegli \"Configura ambiente (prima volta)\" qui sotto — al termine il menu con i pulsanti si aprirà da solo, senza dover richiudere e riaprire l'app."
fi

OPZIONI=$'Avvia sistema per una chiamata\nRivedi frasi raccolte dalle chiamate\nAggiungi uno script alla libreria\nVedi gli script già in libreria\nConfigura profilo azienda (per generazione AI)\nConfigura ambiente (prima volta)\nConfigura API key (prima volta)\nTest: solo audio (senza matching)\nTest: solo motore di matching\nEsci'

while true; do
  SCELTA=$(scegli_da_lista "$OPZIONI" "Cosa vuoi fare?")

  case "$SCELTA" in
    "Avvia sistema per una chiamata") avvia_chiamata ;;
    "Rivedi frasi raccolte dalle chiamate") rivedi_frasi_raccolte ;;
    "Aggiungi uno script alla libreria") aggiungi_script ;;
    "Vedi gli script già in libreria") visualizza_libreria ;;
    "Configura profilo azienda (per generazione AI)") configura_profilo_azienda ;;
    "Configura ambiente (prima volta)")
      setup_ambiente
      # Appena installato l'ambiente, il menu grafico potrebbe ora essere
      # disponibile: ci si passa subito, senza dover richiudere e riaprire
      # l'app per vederlo.
      if tenta_menu_grafico; then
        exit 0
      fi
      ;;
    "Configura API key (prima volta)") configura_api_key ;;
    "Test: solo audio (senza matching)") test_audio ;;
    "Test: solo motore di matching") test_matching ;;
    "Esci"|"") break ;;
  esac
done
